<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <GameDataDir Condition="'$(GameDataDir)' == ''">E:/steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../data/knowledge/rules/actions.json" LogicalName="AutoSlay.ActionCatalog.json" />
    <Compile Remove="tools/**/*.cs" />
    <Reference Include="sts2"><HintPath>$(GameDataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDataDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <None Update="AutoSlayBridge.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
